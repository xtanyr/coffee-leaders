# Development only: Create React App dev server. Production serves build/ through Nginx.
HOST=0.0.0.0
PORT=3100

# Optional development URL (assets / hot reload)
# PUBLIC_URL=http://localhost:3100

# Backend development port (used by setupProxy.js when REACT_APP_API_PROXY is unset)
BACKEND_PORT=3011
BACKEND_HOST=127.0.0.1

# Where setupProxy.js forwards /api in development (overrides BACKEND_PORT)
# REACT_APP_API_PROXY=http://127.0.0.1:3011

# Only needed for production static builds without a reverse proxy on /api
# REACT_APP_API_URL=/api

# Only set CORS_ORIGIN if the browser calls the API from a different origin.
# Same-origin Nginx proxying at /api does not need CORS.
# CORS_ORIGIN=https://leaders.example.com
