# Replace leaders.example.com, the build path, and certificate paths before use.
# This file is the final HTTPS config. Obtain the certificate first, then enable it.

server {
    listen 80;
    server_name leaders.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name leaders.example.com;

    ssl_certificate     /etc/letsencrypt/live/leaders.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/leaders.example.com/privkey.pem;

    # This required include defaults to deny all. Replace it with an approved
    # VPN, SSO, or allowlist policy before making the application reachable.
    include /etc/nginx/snippets/coffee-leaders-access.conf;

    root /srv/coffee-leaders/build;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
